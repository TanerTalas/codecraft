{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.guard.alert": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "alert": "query.is_angry"
            }
          ]
        },
        "alert": {
          "transitions": [
            {
              "default": "!query.is_angry"
            }
          ]
        }
      }
    }
  }
}
