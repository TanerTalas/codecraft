pipeline/cache/
pipeline/raw/

# --- Yerel test dosyalari ---
test-worlds/
*.mcpack
*.mcaddon

# --- Python (uretilen otomasyon script'lerini test ederken) ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor ve isletim sistemi ---
.vs/
.vscode/*
!.vscode/settings.json
